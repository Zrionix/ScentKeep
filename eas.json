{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview-play": {
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": false,
      "android": { "buildType": "app-bundle" }
    },
    "production-sim": {
      "extends": "production",
      "distribution": "internal",
      "ios": { "simulator": true },
      "autoIncrement": false
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6795710068"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
