{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview-play": {
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": false,
      "android": { "buildType": "app-bundle" }
    },
    "production-sim": {
      "extends": "production",
      "distribution": "internal",
      "ios": { "simulator": true },
      "autoIncrement": false
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "./credentials/AuthKey_X25AAYH8QT.p8",
        "ascApiKeyId": "X25AAYH8QT",
        "ascApiKeyIssuerId": "905684d2-c99b-4bb1-91dc-98bcf84d2c81",
        "ascAppId": "6795710068"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
