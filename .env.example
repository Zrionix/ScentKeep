# ============================================================================
# ScentKeep — environment variables
# ============================================================================
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# NAMING RULE (Expo):
#   * EXPO_PUBLIC_*   -> inlined into the CLIENT JS bundle. Only put values here
#                        that are SAFE to ship in a public app (anon keys, SDK
#                        keys designed to be public, hostnames).
#   * everything else -> SERVER / CI / Edge-Function ONLY. NEVER prefix a real
#                        secret with EXPO_PUBLIC_ or it leaks into the binary.
#
# STUB BEHAVIOR: every integration has a stub that activates when its key is
# ABSENT, so the whole app builds and tests with an empty .env. Provide a key to
# switch that integration from stub -> live. See src/lib/env.ts.
#
# EAS GOTCHA: `.env` is gitignored, so EAS cloud build workers never see it. Any
# EXPO_PUBLIC_* missing from the EAS "production" environment ships as a STUB —
# a missing RevenueCat key means the app hands out premium for FREE. Verify with:
#     eas env:list production
# ============================================================================

# --- Supabase (backend / auth / DB) ----------------------------------------
# Where: supabase.com -> ScentKeep project -> Project Settings -> API
# URL + anon key are client-public (RLS protects the data). Service role is NOT.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — server / Edge Functions / CI only. Bypasses RLS. Never ship to client.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET — Supabase CLI personal access token. Used by `supabase link` / `db push`.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- RevenueCat (subscriptions / paywall) ----------------------------------
# Where: app.revenuecat.com -> ScentKeep project -> API keys (public SDK keys).
# Platform-specific: appl_... for iOS, goog_... for Android.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Test Store key for pre-store purchase-logic testing (dev builds only).
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
# SECRET — RevenueCat webhook shared secret, verified by the Supabase Edge
# Function that mirrors subscription status into `subscriptions`. Server only.
REVENUECAT_WEBHOOK_SECRET=

# --- PostHog (product analytics / feature flags / paywall remote config) ----
# Where: posthog.com -> Project Settings -> Project API Key (phc_...). Public.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (crash / error monitoring) -------------------------------------
# DSN is client-public (sentry.io -> Project -> Settings -> Client Keys (DSN)).
# NOTE: enabling Sentry means the App Privacy label must declare Crash Data.
EXPO_PUBLIC_SENTRY_DSN=
# SECRET — build-time source-map upload only. Store as an EAS secret.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Resend (transactional email — only if the email sync upgrade ships) ----
# SECRET — server / Edge Function only (resend.com -> API Keys).
RESEND_API_KEY=

# --- EAS / store submission credentials ------------------------------------
# NOT stored in .env. They live in EAS managed credentials; eas.json points at
# key files. Listed here only as the checklist the founder must provide:
#   APPLE:  App Store Connect API key (.p8) + Key ID + Issuer ID
#   GOOGLE: Play service-account JSON key (serviceAccountKeyPath in eas.json)
